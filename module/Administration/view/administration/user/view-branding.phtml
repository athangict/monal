<?php
/**
 * View -- Administration/UserController/viewAction (branding settings)
 */
$this->headTitle($this->title);
$settings = isset($settings) ? $settings : [];
$appName = !empty($settings['app_name']) ? $settings['app_name'] : 'Monal-ERP';
$appLogo = !empty($settings['app_logo']) ? $settings['app_logo'] : 'images/logo.png';
$appLogoSrc = $this->basePath('/' . ltrim((string) $appLogo, '/'));
$appTemplate = !empty($settings['app_template']) ? $settings['app_template'] : 'ace';
$mailFromEmail = !empty($settings['mail_from_email']) ? $settings['mail_from_email'] : '';
$mailFromName = !empty($settings['mail_from_name']) ? $settings['mail_from_name'] : '';
$smtpHost = !empty($settings['smtp_host']) ? $settings['smtp_host'] : '';
$smtpPort = !empty($settings['smtp_port']) ? (int) $settings['smtp_port'] : 587;
$smtpEncryption = !empty($settings['smtp_encryption']) ? strtolower((string) $settings['smtp_encryption']) : 'tls';
$smtpUsername = !empty($settings['smtp_username']) ? $settings['smtp_username'] : '';
$smtpPassword = !empty($settings['smtp_password']) ? $settings['smtp_password'] : '';
$supportEmail = !empty($settings['support_email']) ? $settings['support_email'] : '';
$supportPhone = !empty($settings['support_phone']) ? $settings['support_phone'] : '';
if ($appTemplate === 'default') {
    $appTemplate = 'ace';
} elseif ($appTemplate === 'ocean') {
    $appTemplate = 'ace-skin-1';
} elseif ($appTemplate === 'sunset') {
    $appTemplate = 'ace-skin-2';
}
?>

