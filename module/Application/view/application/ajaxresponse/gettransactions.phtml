<option value="0">NAN</option>
<?php 
foreach ($transactiondtls as $tdtls):

    if (
        $tdtls->status == 4
        && isset($tdtls->ref_no)
        && trim((string)$tdtls->ref_no) !== ''
    ):

        $remaining = isset($remainingAmounts[(int) $tdtls->id]) ? $remainingAmounts[(int) $tdtls->id] : array('debit' => '0.000', 'credit' => '0.000');
        $debit  = (float) $remaining['debit'];
        $credit = (float) $remaining['credit'];
        $amountLabel = '';

        if ($debit > $credit && $debit > 0) {
            $amountLabel = ' [D:' . $remaining['debit'] . ']';
        } elseif ($credit > 0) {
            $amountLabel = ' [C:' . $remaining['credit'] . ']';
        }

        if ($debit <= 0 && $credit <= 0) {
            continue;
        }
?>
        <option value="<?php echo $tdtls->id; ?>">
            <?php echo $tdtls->ref_no . $amountLabel; ?>
        </option>
<?php
    endif;
endforeach;
?>