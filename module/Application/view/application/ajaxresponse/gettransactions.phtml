<option value="0">NAN</option>
<?php 
foreach ($transactiondtls as $tdtls):

    if (
        ($tdtls->status == 4 && isset($tdtls->ref_no) && trim((string)$tdtls->ref_no) !== '')
        && ($tdtls->against_status < 4)
    ):

        $debit  = (float) $tdtls->debit;
        $credit = (float) $tdtls->credit;
        $amountLabel = '';

        if ($debit > $credit && $debit > 0) {
            $amountLabel = ' [D:' . $tdtls->debit . ']';
        } elseif ($credit > 0) {
            $amountLabel = ' [C:' . $tdtls->credit . ']';
        }
?>
        <option value="<?php echo $tdtls->id; ?>">
            <?php echo $tdtls->ref_no . $amountLabel; ?>
        </option>
<?php
    endif;
endforeach;
?>