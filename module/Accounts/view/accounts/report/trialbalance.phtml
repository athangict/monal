				defaultSubmit: new FormValidation.plugins.DefaultSubmit(),
			},
		}).on('core.element.validated', function (e) {
			if (e.valid) {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-invalid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-valid');
			} else {
				$('div#'+ e.field.replace('[]','') +'_chosen').removeClass('is-valid');
				$('div#'+ e.field.replace('[]','') +'_chosen').addClass('is-invalid');
			}
		});
		$('form select').chosen().change(function () {
			fv.revalidateField($(this).attr('name'));
		});
		
		var title_table = 'Trial Balance Report: ' +' from '+$('input#start_date').val()+' to '+$('input#end_date').val();
		$('#dataTables').DataTable({
			"paging": false,
			"buttons": [
				{ extend: 'copy', exportOptions: { modifier: { selected: null }, rows: function (idx, data, node) { return $(node).is(':visible'); } } },
				{ extend: 'csv', exportOptions: { modifier: { selected: null }, rows: function (idx, data, node) { return $(node).is(':visible'); } } },
				{ extend: 'excel', exportOptions: { modifier: { selected: null }, rows: function (idx, data, node) { return $(node).is(':visible'); } } },
				{ extend: 'pdf', exportOptions: { modifier: { selected: null }, rows: function (idx, data, node) { return $(node).is(':visible'); } } },
				{ extend: 'print', exportOptions: { modifier: { selected: null }, rows: function (idx, data, node) { return $(node).is(':visible'); } } }
			]
		});

		$('.tb-toggle .tb-caret').attr('data-state', 'collapsed');

		function setCaret($toggle, state) {
			var $caret = $toggle.find('.tb-caret').first();
			$caret.attr('data-state', state);
			if (state === 'loading') {
				$caret.html('<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>');
				return;
			}
			if (state === 'expanded') {
				$caret.text('-');
				return;
			}
			$caret.text('+');
		}

		function isExpanded($toggle) {
			return $toggle.find('.tb-caret').first().attr('data-state') === 'expanded';
		}

		function hideChildren(nodeId) {
			var $children = $('tr.tb-row[data-parent="' + nodeId + '"]');
			$children.each(function(){
				var childNode = $(this).attr('data-node');
				$(this).hide();
				if (childNode) {
					hideChildren(childNode);
				}
				setCaret($(this).find('.tb-toggle').first(), 'collapsed');
			});
		}

		function getNextLevel(level) {
			if (level === 'class') { return 'group'; }
			if (level === 'group') { return 'head'; }
			if (level === 'head') { return 'subhead'; }
			return '';
		}

		function getParentId(nodeId) {
			var parts = (nodeId || '').split('-');
			return parts.length > 1 ? parts[1] : '';
		}

		function loadChildren($toggle, $row, nodeId) {
			var nextLevel = getNextLevel($row.attr('data-level'));
			if (!nextLevel || $row.attr('data-loaded') === '1' || $row.attr('data-loading') === '1') {
				return;
			}
			$row.attr('data-loading', '1');
			setCaret($toggle, 'loading');
			$toggle.attr('aria-busy', 'true');

			$.post(
				"<?php echo $this->url('report', array('action' => 'fetchreportlevel'));?>",
				{
					report: 'trialbalance',
					level: nextLevel,
					parent_id: getParentId(nodeId),
					activity: $('#location').val(),
					region: $('#region').val(),
					location: $('#location').val(),
					start_date: $('input[name="start_date"]').val(),
					end_date: $('input[name="end_date"]').val()
				},
				function(response) {
					$row.attr('data-loaded', '1');
					if (response && response.success && response.rows) {
						$row.after(response.rows);
						$('tr.tb-row[data-parent="' + nodeId + '"]').show();
						setCaret($toggle, 'expanded');
					} else {
						setCaret($toggle, 'collapsed');
					}
				},
				'json'
			).fail(function() {
				setCaret($toggle, 'collapsed');
				console.error('Failed to load trial balance children for node:', nodeId);
				window.alert('Unable to load the selected level right now. Please try again.');
			}).always(function() {
				$row.attr('data-loading', '0');
				$toggle.removeAttr('aria-busy');
			});
		}

		$(document).on('click', '.tb-toggle', function(e){
			e.preventDefault();
			var $toggle = $(this);
			var $row = $toggle.closest('tr.tb-row');
			if ($row.attr('data-loading') === '1') {
				return;
			}
			var nodeId = $toggle.attr('data-node');
			var $children = $('tr.tb-row[data-parent="' + nodeId + '"]');
			if (!$children.length && $row.attr('data-level') !== 'subhead') {
				loadChildren($toggle, $row, nodeId);
				return;
			}

			if (isExpanded($toggle)) {
				setCaret($toggle, 'collapsed');
				hideChildren(nodeId);
			} else {
				setCaret($toggle, 'expanded');
				$children.show();
			}
		});

	});
</script>
